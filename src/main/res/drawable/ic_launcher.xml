<?xml version="1.0" encoding="utf-8"?>
<!-- SRC PayHook App Icon: Navy circle with white shield + orange webhook bolt -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background circle: SRC Navy -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#17458F" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>

    <!-- Inner accent ring: SRC Orange -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#E78023" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Shield body (inverted triangle / badge shape): White -->
    <item
        android:left="28dp"
        android:top="22dp"
        android:right="28dp"
        android:bottom="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Webhook bolt center mark: Orange -->
    <item
        android:left="44dp"
        android:top="36dp"
        android:right="44dp"
        android:bottom="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#E78023" />
            <corners android:radius="3dp" />
        </shape>
    </item>

</layer-list>
